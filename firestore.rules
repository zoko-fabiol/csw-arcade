rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Salons Fightcade 2 (Messages communautaires & présence en ligne)
    match /fc_lobbies/{gameId}/messages/{msgId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }
    match /fc_lobbies/{gameId}/users/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Défis P2P 15s & signaling WebRTC
    match /fc_challenges/{challengeId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
      match /{subCol}/{docId} {
        allow read, write: if request.auth != null;
      }
    }

    // Profils joueurs, synchronisation multi-appareils & stats RAM (écriture réservée au propriétaire)
    match /users/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
      match /gameStats/{gameId} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == uid;
      }
      match /sync/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
      match /friends/{friendUid} {
        allow read: if request.auth != null && (request.auth.uid == uid || request.auth.uid == friendUid);
        allow write: if request.auth != null && (request.auth.uid == uid || request.auth.uid == friendUid);
      }
    }
    match /friend_requests/{requestId} {
      allow read, write: if request.auth != null;
    }

    // Portefeuilles : lecture uniquement par le propriétaire, écriture strictement serveur
    match /wallets/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Classements automatiques des meilleurs scores par jeu
    match /game_scores/{gameId}/entries/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
